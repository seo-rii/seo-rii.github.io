{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "scripts", "*.js", "*.ts"],
	"exclude": ["node_modules", "build", "review", "vendor", "src/service-worker"]
}
